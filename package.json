{
  "name": "pve-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "types": "cf workers types",
    "typecheck": "npm run types && tsc --noEmit",
    "db:migrate:local": "cf --local --persist-to .wrangler/state d1 migrations apply 00000000-0000-4000-8000-000000000001 --dir migrations",
    "db:migrate": "cf d1 migrations apply --dir migrations",
    "deploy": "node --env-file-if-exists=.env.deploy scripts/deploy.mjs",
    "test": "node --test tests/worker.test.mjs",
    "test:browser": "playwright test",
    "pretest": "npm run build",
    "pretest:browser": "npm run build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cf": "^1.0.0-beta.28",
    "miniflare": "^5.20261101.0-beta",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
